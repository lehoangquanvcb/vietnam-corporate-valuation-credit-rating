# LOCAL ONLY. Copy this file to .env and fill your own Sponsor API key.
# Never commit .env to GitHub.
VNSTOCK_API_KEY=PASTE_YOUR_VNSTOCK_SPONSOR_API_KEY_HERE

# Optional: path to the virtual environment where Sponsor libraries were
# installed by vnstock-installer. Example:
# VNSTOCK_VENV_PATH=C:\Users\YourName\.venv

# Recommended non-interactive settings for automated refresh jobs.
VNSTOCK_INTERACTIVE=0
VNSTOCK_LANGUAGE=2
